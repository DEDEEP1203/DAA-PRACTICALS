def Matrix_Mult_Cost(p):
    n = len(p) - 1
    m = [[0] * n for i in range(n)]
    for l in range(2, n + 1):
        for i in range(n - l + 1):
            j = i + l - 1
            m[i][j] = float('inf')
            for k in range(i, j):
                cost = m[i][k] + m[k + 1][j] + p[i] * p[k + 1] * p[j]
                if cost < m[i][j]:
                    m[i][j] = cost
    return m[0][n - 1]
p = list(map(int, input("Enter matrix dimensions: ").split()))
result = Matrix_Mult_Cost(p)
print("Minimum number of multiplications:", result)
