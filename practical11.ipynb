n = int(input("Enter number of vertices: "))
dist = []
print("Enter distance matrix (use 999 for INF):")
for i in range(n):
    row = list(map(int, input().split()))
    dist.append(row)
for k in range(n):
    for i in range(n):
        for j in range(n):
            dist[i][j] = min(dist[i][j], dist[i][k] + dist[k][j])
print("Shortest Distance Matrix:")
for i in range(n):
    for j in range(n):
        if dist[i][j] >= 999:
            print("INF", end=" ")
        else:
            print(dist[i][j], end=" ")
    print()
