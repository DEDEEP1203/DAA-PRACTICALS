# Bubble Sort
a = list(map(int, input("Enter numbers: ").split()))
n = len(a)
for i in range(n):
    for j in range(n - i - 1):
        if a[j] > a[j + 1]:
            temp = a[j]
            a[j] = a[j + 1]
            a[j + 1] = temp
print("Sorted List:", a)

# Selection Sort
a = list(map(int, input("Enter numbers: ").split()))
n = len(a)
for i in range(n):
    small = i
    for j in range(i + 1, n):
        if a[j] < a[small]:
            small = j
    temp = a[i]
    a[i] = a[small]
    a[small] = temp
print("Sorted List:", a)

# Insertion Sort
a = list(map(int, input("Enter numbers: ").split()))
n = len(a)
for i in range(1, n):
    key = a[i]
    j = i - 1
    while j >= 0 and a[j] > key:
        a[j + 1] = a[j]
        j = j - 1
    a[j + 1] = key
print("Sorted List:", a)

# merge sort
def merge_sort(arr):
    if len(arr) > 1:
        mid = len(arr) // 2
        left = arr[:mid]
        right = arr[mid:]
        merge_sort(left)
        merge_sort(right)
        i = j = k = 0
        while i < len(left) and j < len(right):
            if left[i] < right[j]:
                arr[k] = left[i]
                i += 1
            else:
                arr[k] = right[j]
                j += 1
            k += 1
        while i < len(left):
            arr[k] = left[i]
            i += 1
            k += 1
        while j < len(right):
            arr[k] = right[j]
            j += 1
            k += 1
n = int(input("Enter number of elements: "))
arr = []
print("Enter the elements:")
for i in range(n):
    arr.append(int(input()))
merge_sort(arr)
print("Sorted array:")
print(arr)

# Quick sort
def quick_sort(a):
    if len(a) <= 1:
        return a
    pivot = a[0]
    left = []
    right = []
    for i in a[1:]:
        if i <= pivot:
            left.append(i)
        else:
            right.append(i)
    return quick_sort(left) + [pivot] + quick_sort(right)
a = list(map(int, input("Enter numbers: ").split()))
print("Sorted list:", quick_sort(a))
