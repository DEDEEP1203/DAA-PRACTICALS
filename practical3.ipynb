a = list(map(int, input("Enter numbers: ").split()))
n = len(a)
# Build Max Heap
for i in range(n // 2 - 1, -1, -1):
    j = i
    while 2 * j + 1 < n:
        child = 2 * j + 1
        if child + 1 < n and a[child + 1] > a[child]:
            child = child + 1
        if a[j] < a[child]:
            temp = a[j]
            a[j] = a[child]
            a[child] = temp
            j = child
        else:
            break
# Heap Sort
for i in range(n - 1, 0, -1):
    temp = a[0]
    a[0] = a[i]
    a[i] = temp
    j = 0
    while 2 * j + 1 < i:
        child = 2 * j + 1
        if child + 1 < i and a[child + 1] > a[child]:
            child = child + 1
        if a[j] < a[child]:
            temp = a[j]
            a[j] = a[child]
            a[child] = temp
            j = child
        else:
            break
print("Sorted array:", a)
