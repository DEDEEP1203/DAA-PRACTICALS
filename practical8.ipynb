#bfs
from collections import deque
def bfs(adj):
    n = len(adj)
    visited = [False] * n
    res = []
    src = 0
    g = deque()
    g.append(src)
    visited[src] = True
    while g:
        u = g.popleft()
        res.append(u)
        for v in adj[u]:
            if not visited[v]:
                g.append(v)
                visited[v] = True
    return res
n = int(input("Enter number of vertices: "))
adj = []
for i in range(n):
    a = list(map(int, input("Enter adjacent vertices of " + str(i) + ": ").split()))
    adj.append(a)
print("BFS Traversal:", bfs(adj))

#dfs
visited = []
def dfs(node):
    if node not in visited:
        print(node, end=" ")
        visited.append(node)
        for v in graph.get(node, []):
            dfs(v)
n = int(input("Enter number of vertices: "))
graph = {}
for i in range(n):
    node = input("Enter vertex: ").strip()
    graph[node] = input("Enter connections: ").split()
start = input("Enter starting vertex: ").strip()
print("DFS Traversal:")
dfs(start)
